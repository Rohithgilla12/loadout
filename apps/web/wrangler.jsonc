{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loadout-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // id omitted on purpose: wrangler auto-provisions the namespace on first deploy
    { "binding": "SHARES" }
  ],
  "routes": [{ "pattern": "loadout.gilla.fun", "custom_domain": true }],
  "observability": { "enabled": true }
}
